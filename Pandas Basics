import pandas as pd
import numpy as np

# 1. DataFrame from dictionary
df = pd.DataFrame({
    'Name': ['A', 'B', 'C'],
    'Age': [20, 25, 30]
})
print(df)

# 2. Load CSV and show first/last 5 rows
# df = pd.read_csv('your_file.csv')
# print(df.head())
# print(df.tail())

# Demo DataFrame (use this if you don't have a CSV yet)
df = pd.DataFrame({
    'Name': ['Alice', 'Bob', 'Charlie', 'David', 'Eve', 'Frank'],
    'Age': [22, 28, 35, 24, 31, 27],
    'Salary': [45000, 52000, 61000, 39000, 48000, 55000],
    'Department': ['HR', 'IT', 'IT', 'Finance', 'HR', 'IT']
})

print(df.head())   # first 5
print(df.tail())   # last 5

# 3. Column names, dtypes, summary stats
print(df.columns)
print(df.dtypes)
print(df.describe())          # numeric summary
print(df.info())              # fuller overview

# 4. Select columns and rows by index
print(df['Name'])                    # single column
print(df[['Name', 'Age']])           # multiple columns
print(df.iloc[0])                    # first row (by position)
print(df.iloc[1:4])                  # rows 1–3
print(df.loc[0])                     # row with label/index 0

# 5. Filter rows
print(df[df['Age'] > 25])
print(df[df['Salary'] < 50000])
print(df[(df['Age'] > 25) & (df['Salary'] < 50000)])  # combined

# 6. Sort
print(df.sort_values(by='Age'))
print(df.sort_values(by=['Department', 'Salary'], ascending=[True, False]))

# 7. Save to CSV
df.to_csv('output.csv', index=False)
print("Saved to output.csv")
